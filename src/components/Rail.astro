---
// The rail beside a document: Copy link, what it is and where else it lives, then its contents.
// Narrow screens open it as a drawer from the menu button above the document.
import type { Heading } from "../lib/document";
import { ago, kindName, shownPath, stamp, statusOf } from "../lib/format";
import { type Doc, docUrl } from "../lib/library";
import Icon from "./Icon.astro";
import Time from "./Time.astro";

const { doc, headings, docs } = Astro.props as { doc: Doc; headings: Heading[]; docs: Doc[] };
const status = statusOf(doc);
const state = { draft: ["Draft", "Only on this branch, or changed here"], merged: ["Merged", "On the default branch"], local: ["Local", "Never committed"] }[status];
const where = doc.worktree.key === "~notes" ? "Notes" : doc.local ? `${doc.repo}, local` : `${doc.repo}, ${doc.worktree.key}`;
const others = docs.filter((other) => other.repo === doc.repo && other.path === doc.path && other !== doc).toSorted((a, b) => b.mtime - a.mtime);
const label = headings.length ? "Contents and details" : "Details";
---
<div class="lectern-rail-head">
  <button class="lectern-button lectern-rail-open" type="button" popovertarget="lectern-rail" aria-label={label} title={label}><Icon name="menu" /></button>
</div>
<aside class="lectern-rail" id="lectern-rail" popover aria-label="About this document">
  <button class="lectern-button lectern-copy" type="button" data-copy><Icon name="link" /><span>Copy link</span></button>
  <section class="lectern-details">
    <h2>Details</h2>
    <dl>
      <div><dt>Kind</dt><dd>{kindName(doc.kind)}</dd></div>
      <div><dt>Status</dt><dd><span class={`lectern-state ${status}`}>{state[0]}</span><span class="lectern-note">{state[1]}</span></dd></div>
      <div><dt>Updated</dt><dd><Time ms={doc.mtime} text={ago(doc.mtime)} /><span class="lectern-note">{stamp(doc.mtime)}</span></dd></div>
      <div><dt>Location</dt><dd>{where}<code>{shownPath(doc)}</code></dd></div>
    </dl>
  </section>
  {others.length > 0 && <section class="lectern-versions"><h2>Also on</h2><ul>{others.map((other) => <li><a href={docUrl(other)}><span>{other.worktree.key}</span><Time ms={other.mtime} text={ago(other.mtime)} /></a></li>)}</ul></section>}
  {headings.length > 0 && <nav class="lectern-toc" aria-label="Contents"><h2>Contents</h2><ol>{headings.map((h) => <li class={`h${h.level}`}><a href={`#${h.id}`}>{h.text}</a></li>)}</ol></nav>}
</aside>
