---
// The rail beside a document: its contents, and about it: Copy link (and Copy Markdown on a Markdown
// document), what it is, when you marked it read (with Mark as read), what to compare it with and where
// else it lives. Wide screens pin the about part at the top right of the page, as the library sits at the
// left; narrower ones keep it above the contents. Narrow screens open the rail as a drawer from the menu
// button above the document.
import type { Heading } from "../lib/document";
import { ago, kindName, shownPath, stamp, statusOf } from "../lib/format";
import { type Doc, docUrl } from "../lib/library";
import Icon from "./Icon.astro";
import Time from "./Time.astro";

const { doc, headings, docs, read, marked, version, against } = Astro.props as { doc: Doc; headings: Heading[]; docs: Doc[]; read?: { mtime: number; unread: boolean }; marked?: number; version: number; against: string | null };
// When you marked this version read, or else the earlier version you last marked, if any.
const lastMark = marked ?? (read?.unread ? read.mtime : undefined);
const status = statusOf(doc);
const state = { draft: ["Draft", "Only on this branch, or changed here"], merged: ["Merged", "On the default branch"], local: ["Local", "Never committed"] }[status];
const where = doc.worktree.key === "~notes" ? "Notes" : doc.local ? `${doc.repo}, local` : `${doc.repo}, ${doc.worktree.key}`;
const others = docs.filter((other) => other.repo === doc.repo && other.path === doc.path && other !== doc).toSorted((a, b) => b.mtime - a.mtime);
// The versions this one can be compared with: your last read (or the read before last, with this version
// marked), and each other branch's copy.
const compare = [...(read ? [{ key: "read", text: read.unread ? "Since your last read" : "Since your read before last", ms: read.mtime }] : []), ...others.map((other) => ({ key: other.worktree.key, text: `Against ${other.worktree.key}`, ms: other.mtime }))];
const label = headings.length ? "Contents and details" : "Details";
---
<div class="lectern-rail-head">
  <button class="lectern-button lectern-rail-open" type="button" popovertarget="lectern-rail" aria-label={label} title={label}><Icon name="menu" /></button>
</div>
<aside class="lectern-rail" id="lectern-rail" popover aria-label="About this document">
  <div class="lectern-about">
  <div class="lectern-copies">
    <button class="lectern-button lectern-copy" type="button" data-copy><Icon name="link" /><span>Copy link</span></button>
    {doc.path.endsWith(".md") && <button class="lectern-button lectern-copy" type="button" data-copy={`/raw${docUrl(doc)}`}><span>Copy Markdown</span></button>}
  </div>
  <section class="lectern-details">
    <h2>Details</h2>
    <dl>
      <div><dt>Kind</dt><dd>{kindName(doc.kind)}</dd></div>
      <div><dt>Status</dt><dd><span class={`lectern-state ${status}`}>{state[0]}</span><span class="lectern-note">{state[1]}</span></dd></div>
      <div><dt>Updated</dt><dd><Time ms={doc.mtime} text={ago(doc.mtime)} /><span class="lectern-note">{stamp(doc.mtime)}</span></dd></div>
      <div><dt>Read</dt><dd data-marked={marked && version}>
        {lastMark === undefined ? "Not yet" : <Time ms={lastMark} text={ago(lastMark)} />}
        {lastMark !== undefined && <span class="lectern-note">{marked ? "This version" : "An earlier version"}</span>}
        {!marked && <button class="lectern-button" type="button" data-read={version}>Mark as read</button>}
      </dd></div>
      <div><dt>Location</dt><dd>{where}<code>{shownPath(doc)}</code></dd></div>
    </dl>
  </section>
  {compare.length > 0 && <section class="lectern-versions"><h2>Changes</h2><ul>{compare.map((item) => <li><a href={`${docUrl(doc)}?diff=${encodeURIComponent(item.key)}`} aria-current={item.key === against ? "page" : undefined}><span>{item.text}</span><Time ms={item.ms} text={ago(item.ms)} /></a></li>)}</ul></section>}
  {others.length > 0 && <section class="lectern-versions"><h2>Also on</h2><ul>{others.map((other) => <li><a href={docUrl(other)}><span>{other.worktree.key}</span><Time ms={other.mtime} text={ago(other.mtime)} /></a></li>)}</ul></section>}
  </div>
  {headings.length > 0 && <nav class="lectern-toc" aria-label="Contents"><h2>Contents</h2><ol>{headings.map((h) => <li class={`h${h.level}`}><a href={`#${h.id}`}>{h.text}</a></li>)}</ol></nav>}
</aside>
