---
// What every page adds to its head: the saved theme before first paint, the kit's two faces and
// Lectern's styles. Index pages also take the kit's CSS; a document carries its own.
import { Font } from "astro:assets";
import "../styles/lectern.css";

const { kit = false } = Astro.props as { kit?: boolean };
---
<script is:inline>
  // The saved theme, set before the page first paints so a page never flashes the system's theme.
  try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
</script>
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<Font cssVariable="--font-hanken" preload />
<Font cssVariable="--font-geist-mono" />
{kit && <link rel="stylesheet" href="/assets/kit.css" />}
