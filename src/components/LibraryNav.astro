---
// The library: recent documents, then every repository and the notes, with how many documents and
// drafts each holds. Every page shows it at the left; current is the repository shown, or "home".
import { drafts } from "../lib/format";
import { library, type Repo, unique } from "../lib/library";

const { current } = Astro.props as { current?: unknown };
const { repos, docs } = await library();
const all = unique(docs);
const list = [...repos.values()];
const groups: [string | undefined, Repo[]][] = [["Repositories", list.filter((repo) => !repo.notes)], ["Notes", list.filter((repo) => repo.notes)]];
const entry = (repo: Repo) => {
  const own = all.filter((doc) => doc.repo === repo.name);
  return { repo, count: own.length, drafts: drafts(own), main: repo.worktrees.find((other) => other.main) ?? repo.worktrees[0] };
};
---
<nav class="hub-nav" aria-label="Library">
  <ul><li><a href="/" aria-current={current === "home" ? "page" : undefined}><span class="hub-index-name">Recent</span></a></li></ul>
  {groups.filter(([, repos]) => repos.length).map(([heading, repos]) => (
    <Fragment>
      <h2>{heading}</h2>
      <ul>
        {repos.map(entry).map(({ repo, count, drafts, main }) => (
          <li><a href={main.url} aria-current={repo === current ? "page" : undefined}><span class="hub-index-name">{repo.notes ? "Notes" : repo.name}</span><span class="hub-index-n">{count}<span class="hub-sr"> documents</span>{drafts > 0 && <Fragment><span aria-hidden="true">/</span><span class="hub-warn"><span class="hub-sr">, </span>{drafts}<span class="hub-sr"> {drafts === 1 ? "draft" : "drafts"}</span></span></Fragment>}</span></a></li>
        ))}
      </ul>
    </Fragment>
  ))}
</nav>
