---
// Lectern's bar, on every page: home, where you are, search, theme.
import SearchField from "./SearchField.astro";

interface Props {
  crumbs: [string, string?][];
  doc?: { url: string; mtime: number };
  home: boolean;
  query: string;
}
const { crumbs, doc, home, query } = Astro.props;
---
<div class="lectern-bar" role="banner" data-doc={doc?.url} data-mtime={doc && Math.round(doc.mtime)}>
  <a class="lectern-mark" href="/"><img src="/icon-192.png" alt="" width="28" height="28" />Lectern</a>
  {crumbs.length ? (
    <nav class="lectern-crumbs" aria-label="Breadcrumb"><ol>{crumbs.map(([text, url], i) => (i < crumbs.length - 1 && url ? <li><a href={url}>{text}</a></li> : <li><span aria-current="page">{text}</span></li>))}</ol></nav>
  ) : <span class="lectern-crumbs"></span>}
  <div class="lectern-tools">{!home && <SearchField query={query} />}<div data-theme-control></div></div>
</div>
