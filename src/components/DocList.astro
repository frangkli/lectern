---
// Documents as a list, in groups (days, kinds or folders): each title with its status and when it
// changed, its summary, then what and where it is. A list that is all one kind, or all in one place,
// leaves that out. Search results add the path, where a term may have matched; the timeline shows
// the time of day.
import { ago, clock, kindName, plural, shownPath } from "../lib/format";
import { type Doc, docUrl } from "../lib/library";
import Icon from "./Icon.astro";
import Marked from "./Marked.astro";
import Time from "./Time.astro";

interface Props {
  groups: { label?: string; note?: string; rows: { doc: Doc; snippet?: string }[] }[];
  terms?: string[];
  kind?: boolean;
  where?: boolean;
  clockTime?: boolean;
  allLocal?: boolean;
}
const { groups, terms = [], kind = true, where = true, clockTime = false, allLocal = false } = Astro.props;
---
{groups.map(({ label, note, rows }) => (
  <section class="lectern-group">
    {label && <h2><span>{label}</span>{note && <span class="lectern-group-note">{note}</span>}<span class="lectern-group-n">{plural(rows.length, "document")}</span></h2>}
    <ol class="lectern-list">
      {rows.map(({ doc, snippet }) => {
        const summary = snippet ?? doc.summary;
        const hasMeta = kind || where || terms.length > 0;
        return (
          <li class="lectern-item">
            <p class="lectern-item-head"><a class="lectern-title" href={docUrl(doc)} title={shownPath(doc)} data-doc={docUrl(doc)} data-mtime={Math.round(doc.mtime)}><Marked text={doc.title} terms={terms} /></a>{!allLocal && (doc.local ? <span class="lectern-flag">Local</span> : !doc.merged && <span class="lectern-flag draft">Draft</span>)}</p>
            <Time ms={doc.mtime} text={clockTime ? clock(doc.mtime) : ago(doc.mtime)} />
            {summary && <p class="lectern-summary"><Marked text={summary} terms={terms} /></p>}
            {hasMeta && (
              <p class="lectern-meta">
                {kind && <span>{kindName(doc.kind)}</span>}
                {where && <span>{doc.local ? (doc.repo === "notes" ? "Notes" : `${doc.repo}, local`) : <Fragment>{doc.repo}<span class="lectern-branch"><Icon name="branch" /><Marked text={doc.worktree.key} terms={terms} /></span></Fragment>}</span>}
                {terms.length > 0 && <span><span class="lectern-path"><Marked text={shownPath(doc)} terms={terms} /></span></span>}
              </p>
            )}
          </li>
        );
      })}
    </ol>
  </section>
))}
