---
// A repository's documents on one branch, a document, or a file beside a document.
import { readFile } from "node:fs/promises";
import { extname } from "node:path";
import BranchMenu from "../components/BranchMenu.astro";
import DocList from "../components/DocList.astro";
import DocLayout from "../layouts/DocLayout.astro";
import IndexLayout from "../layouts/IndexLayout.astro";
import { diffHtml } from "../lib/diff";
import { documentHtml, escapeHtml, linkSources } from "../lib/document";
import { ago, drafts, kindName, kindsIn, plural, stamp } from "../lib/format";
import { type Doc, docRoots, docUrl, encodePath, library, resolveFile, route, trackedFiles } from "../lib/library";
import { lastRead } from "../lib/reads";
import { types } from "../lib/types";

const pathname = decodeURIComponent(Astro.url.pathname);
const resolve = async (fresh: boolean) => {
  const lib = await library(fresh);
  const { repo, worktree, path, extra } = route(pathname, lib.repos);
  const main = repo && (repo.worktrees.find((candidate) => candidate.main) ?? repo.worktrees[0]);
  const shown = worktree ?? main;
  const doc = shown && path ? lib.docs.find((candidate) => candidate.worktree === shown && candidate.path === path) : undefined;
  const missing = !repo || !main || !shown || (path ? !doc || !worktree : extra);
  return { docs: lib.docs, repo, worktree, path, main, shown, doc, missing };
};
// A request that finds nothing, like a link to a document saved a moment ago, scans again before it says so.
let page = await resolve(false);
if (page.missing) page = await resolve(true);
const { docs, repo, worktree, path, main, shown, doc } = page;

// A document's images and other files resolve beside it, so its relative links work in Lectern.
if (worktree && path && !doc && !/\.(md|html)$/.test(path)) {
  const found = await resolveFile(worktree, path);
  if (found && !found.directory) return new Response(await readFile(found.file), { headers: { "content-type": types[extname(found.file).toLowerCase()] ?? "application/octet-stream", "x-content-type-options": "nosniff" } });
}
// A link into a removed worktree, or to a file the worktree no longer has, falls back to the main checkout.
const fallback = path && (!doc || !worktree) && docs.find((candidate) => candidate.worktree === main && candidate.path === path);
if (fallback) return Astro.redirect(docUrl(fallback), 302);
const found = doc && (await resolveFile(shown!, path!));
if (page.missing || !repo || !main || !shown || (doc && !found)) return Astro.rewrite("/404");

const crumbs: [string, string?][] = repo.notes ? [["Notes", shown.url]] : [[repo.name, main.url], [shown.local ? "local" : shown.key, shown.url]];
const rendered = found && (await documentHtml(found.file));
// ?diff= shows the document with its changes marked since an earlier version: ?diff=read for the one you
// last read, or ?diff=<branch> for that branch's copy. Without one, a line says when it changed since you read it.
const read = found && (await lastRead(found.file));
const against = Astro.url.searchParams.get("diff");
let banner = "";
const readAt = read && `<span class="lectern-note" title="${stamp(read.mtime)}">${ago(read.mtime).replace(/^(Just|Yesterday)/, (word) => word.toLowerCase())}</span>`;
if (rendered && against !== null) {
  const other = docs.find((d) => d.repo === repo.name && d.path === path && d !== doc && d.worktree.key === against);
  const base = against === "read" ? read?.file : other && (await resolveFile(other.worktree, path!))?.file;
  const content = /(<main\b[^>]*>)([\s\S]*)(<\/main>)/i;
  const [before, after] = [base && content.exec((await documentHtml(base)).html)?.[2], content.exec(rendered.html)?.[2]];
  if (before === undefined || after === undefined) return Astro.redirect(docUrl(doc!), 302);
  rendered.html = rendered.html.replace(content, (_, open, __, close) => open + diffHtml(before, after) + close);
  const label = read && against === "read" ? `${before === after ? "No changes" : "Changes"} since your last read,${readAt}` : `${before === after ? "No changes" : "Changes"} against ${escapeHtml(against)}`;
  banner = `<p class="lectern-diffbar"><span>${label}</span><span class="lectern-key"><ins class="lectern-ins">Added</ins> <del class="lectern-del">Removed</del></span><a href="${docUrl(doc!)}">Show document</a></p>`;
} else if (read?.unread) {
  banner = `<p class="lectern-diffbar"><span>Updated since your last read,${readAt}</span><a href="?diff=read">Show changes</a></p>`;
}
// Code citing a file in the repo, like `src/a.ts:42`, links to Lectern's view of it, or to the document
// when it cites one. A local doc cites the main checkout. After the diff, so links don't count as changes.
const sources = rendered && !repo.notes ? (shown.local ? main : shown) : undefined;
const cited = (file: string, lines: string) => (/\.(md|html)$/.test(file) && docRoots.some((root) => file.startsWith(`${root}/`)) ? `${sources!.url}/${encodePath(file)}` : `/source${sources!.url}/${encodePath(file)}${lines}`);
if (rendered && sources) rendered.html = linkSources(rendered.html, await trackedFiles(sources.dir), cited);
// The docs a worktree's view lists: its own, plus the repo's local docs in the main checkout's view.
const list = (shown.local ? docs.filter((d) => d.worktree === shown) : docs.filter((d) => d.worktree === shown || (shown.main && d.worktree === repo.local))).toSorted((a, b) => b.mtime - a.mtime);
const count = drafts(list);
const picker = !repo.notes && repo.worktrees.length > 1;
// Notes and local folders group by folder, and show each note's kind; committed docs group by kind.
const byFolder = Boolean(repo.notes || shown.local);
const groups = byFolder ? Map.groupBy(list, (d) => (d.path.includes("/") ? d.path.slice(0, d.path.lastIndexOf("/")) : "")) : Map.groupBy(list, (d) => d.kind);
const keys = byFolder ? [...groups.keys()].toSorted() : kindsIn(list);
const listGroups = keys.map((key) => ({ label: byFolder ? (key ? `${key}/` : "Top level") : kindName(key, true), rows: groups.get(key)!.map((d: Doc) => ({ doc: d })) }));
---
{rendered ? (
  <DocLayout html={rendered.html} headings={rendered.headings} banner={banner} read={read || undefined} against={against} doc={doc!} docs={docs} crumbs={[...crumbs, [doc!.title]]} current={repo} />
) : (
  <IndexLayout title={repo.notes ? "Notes" : `${repo.name} · ${shown.label}`} crumbs={crumbs} current={repo}>
    <header class="lectern-head" slot="head">
      <h1>{repo.notes ? "Notes" : repo.name}</h1>
      <div class="lectern-sub">{plural(list.length, "document")}{!repo.notes && <Fragment> on {picker ? <BranchMenu repo={repo} docs={docs} shown={shown.local ? main : shown} /> : shown.label}</Fragment>}{count > 0 && <span class="lectern-warn">, {plural(count, "draft")}</span>}</div>
    </header>
    {list.length ? (
      <DocList groups={listGroups} kind={byFolder} where={false} allLocal={byFolder} />
    ) : (
      <div class="lectern-empty"><p class="lectern-empty-title">No documents here yet</p><p>Anything saved under {docRoots.map((root, i) => <Fragment>{i > 0 && " or "}<code>{root}/</code></Fragment>)} in this checkout shows up here.</p></div>
    )}
  </IndexLayout>
)}
